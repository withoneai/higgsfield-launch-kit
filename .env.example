# Your One API key. After `one init`, find it in ~/.one/config.json (apiKey)
# or in the dashboard at https://app.withone.ai
ONE_SECRET=

# Your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Connection keys from `one --agent list` (the `key` field for each platform).
# Any one left blank falls back to the recorded data in fixtures/.

# `one add shopify-admin`. Read only: the kit needs read_products, nothing else.
ONE_CONNECTION_SHOPIFY=

# `one add higgsfield-ai`, with an API key ID and secret from
# https://console.higgsfield.ai (API keys). Generations spend
# your Higgsfield credits; the kit asks before every spend unless you pass --yes.
ONE_CONNECTION_HIGGSFIELD=

# `one add google-drive`. A new private folder is created per run.
ONE_CONNECTION_GOOGLE_DRIVE=
# Optional: create the review folders inside this Drive folder id.
# DRIVE_PARENT_FOLDER_ID=

# Optional: post the review summary to Slack. Both lines or neither.
# ONE_CONNECTION_SLACK=
# SLACK_CHANNEL=#launches

# Optional: override the Claude model (default claude-opus-5)
# CLAUDE_MODEL=claude-opus-5
